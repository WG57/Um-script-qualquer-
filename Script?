         local function checkTargetEgg()
            for _, obj in ipairs(workspace:GetDescendants()) do
               local lowerName = string.lower(obj.Name)
               
               local matchesRarity = false
               if SelectedRarity == "Todos (Divine/Eternal/Secret)" then
                  matchesRarity = string.find(lowerName, "divine") or string.find(lowerName, "eternal") or string.find(lowerName, "secret")
               else
                  matchesRarity = string.find(lowerName, string.lower(SelectedRarity))
               end
               
               local matchesPet = false
               if SelectedPet == "Qualquer Pet" then
                  matchesPet = true
               else
                  matchesPet = string.find(lowerName, string.lower(SelectedPet))
               end
               
               if matchesRarity and matchesPet then
                  return true, obj
               end
            end
            return false, nil
         end

         local function smoothTeleportAndCollect(targetObj)
            if isTeleporting or not targetObj then return end
            isTeleporting = true
            
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then 
               isTeleporting = false 
               return 
            end
            
            local hrp = char.HumanoidRootPart
            local originalCFrame = hrp.CFrame
            
            local noclipConn = game:GetService("RunService").Stepped:Connect(function()
               for _, part in ipairs(char:GetDescendants()) do
                  if part:IsA("BasePart") then
                     part.CanCollide = false
                  end
               end
            end)
            
            local targetPos = targetObj:IsA("BasePart") and targetObj.Position or (targetObj:FindFirstChildWhichIsA("BasePart") and targetObj:FindFirstChildWhichIsA("BasePart").Position)
            
            if targetPos then
               StatusLabel.Text = "Status: Indo pegar (" .. targetObj.Name .. ")..."
               StatusLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
               
               local speed = 200
               local currentPos = hrp.Position
               local distance = (targetPos - currentPos).Magnitude
               local travelTime = distance / speed
               local startTime = tick()
               
               while (tick() - startTime) < travelTime do
                  if not char or not hrp then break end
                  local alpha = (tick() - startTime) / travelTime
                  hrp.CFrame = CFrame.new(currentPos:Lerp(targetPos, alpha))
                  task.wait()
               end
               
               if hrp then hrp.CFrame = CFrame.new(targetPos) end
               
               task.wait(0.2)
               local prompt = targetObj:FindFirstChildOfClass("ProximityPrompt") or targetObj:FindFirstChildWhichIsA("ProximityPrompt", true)
               if prompt and fireproximityprompt then
                  fireproximityprompt(prompt)
               end
               task.wait(0.5)
               
               StatusLabel.Text = "Status: Voltando para base..."
               local returnStartPos = hrp.Position
               local returnTargetPos = originalCFrame.Position
               local returnDistance = (returnTargetPos - returnStartPos).Magnitude
               local returnTime = returnDistance / speed
               local returnStartTime = tick()
               
               while (tick() - returnStartTime) < returnTime do
                  if not char or not hrp then break end
                  local alpha = (tick() - returnStartTime) / returnTime
                  hrp.CFrame = CFrame.new(returnStartPos:Lerp(returnTargetPos, alpha))
                  task.wait()
               end
               
               if hrp then hrp.CFrame = originalCFrame end
               
               StatusLabel.Text = "Status: Item coletado com sucesso!"
               StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 127)
            end
            
            if noclipConn then noclipConn:Disconnect() end
            isTeleporting = false
         end

         local function sniperHop()
            StatusLabel.Text = "Status: Buscando novo servidor..."
            local maxPlayersAllowed = tonumber(InputBox.Text) or 4
            local placeId = game.PlaceId
            local servers = {}
            
            pcall(function()
               local url = string.format("https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Asc&limit=100", tostring(placeId))
               local response = game:HttpGet(url)
               local data = HttpService:JSONDecode(response)
               
               if data and data.data then
                  for _, v in ipairs(data.data) do
                     if type(v) == "table" and v.id ~= game.JobId and v.playing <= maxPlayersAllowed then
                        table.insert(servers, v.id)
                     end
                  end
               end
            end)
            
            if #servers > 0 then
               local randomServer = servers[math.random(1, #servers)]
               TeleportService:TeleportToPlaceInstance(placeId, randomServer, LocalPlayer)
            else
               TeleportService:Teleport(placeId, LocalPlayer)
            end
         end

