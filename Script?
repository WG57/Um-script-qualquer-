TabLP:CreateSection("Auto Drible & Giro")

local AutoDribleEnabled = false
local DribleSpeed = 720 -- Graus por segundo
local DribleConnection

TabLP:CreateToggle({
   Name = "Auto Drible (Girar & Andar)",
   CurrentValue = false,
   Flag = "AutoDribleToggle",
   Callback = function(Value)
      AutoDribleEnabled = Value
      local RunService = game:GetService("RunService")
      local LocalPlayer = game:GetService("Players").LocalPlayer

      if AutoDribleEnabled then
         DribleConnection = RunService.RenderStepped:Connect(function(deltaTime)
            if LocalPlayer.Character then
               local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
               local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")

               if hrp and hum then
                  -- Faz o personagem caminhar para a frente continuamente
                  hum:Move(Vector3.new(0, 0, -1), true)
                  -- Aplica rotação aleatória/contínua no eixo Y
                  hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(DribleSpeed * deltaTime), 0)
               end
            end
         end)
      else
         if DribleConnection then
            DribleConnection:Disconnect()
            DribleConnection = nil
         end
      end
   end,
})

