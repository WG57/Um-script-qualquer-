TabLP:CreateSection("Auto Drible & Andar em Círculo")

local DribleEnabled = false
local DribleRadius = 8
local DribleSpeed = 5
local DribleDirection = "Direita" -- "Esquerda", "Direita", "Aleatório"

local DribleConnection
local RandomChangeThread
local currentAngle = 0
local actualDirMult = 1

TabLP:CreateToggle({
   Name = "Auto Drible (Andar em Círculo)",
   CurrentValue = false,
   Flag = "AutoDribleToggle",
   Callback = function(Value)
      DribleEnabled = Value
      local RunService = game:GetService("RunService")
      local LocalPlayer = game:GetService("Players").LocalPlayer

      if DribleEnabled then
         actualDirMult = (DribleDirection == "Esquerda") and -1 or 1

         if DribleDirection == "Aleatório" then
            RandomChangeThread = task.spawn(function()
               while DribleEnabled do
                  task.wait(math.random(2, 5))
                  if DribleEnabled and DribleDirection == "Aleatório" then
                     actualDirMult = (math.random(1, 2) == 1) and 1 or -1
                  end
               end
            end)
         end

         DribleConnection = RunService.RenderStepped:Connect(function(deltaTime)
            if LocalPlayer.Character then
               local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
               local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")

               if hrp and hum then
                  currentAngle = currentAngle + (DribleSpeed * actualDirMult * deltaTime)
                  
                  local offsetX = math.cos(currentAngle) * DribleRadius
                  local offsetZ = math.sin(currentAngle) * DribleRadius
                  
                  local moveDirection = Vector3.new(offsetX, 0, offsetZ)
                  if moveDirection.Magnitude > 0 then
                     hum:Move(moveDirection.Unit, false)
                  end
               end
            end
         end)
      else
         if DribleConnection then
            DribleConnection:Disconnect()
            DribleConnection = nil
         end
         if RandomChangeThread then
            task.cancel(RandomChangeThread)
            RandomChangeThread = nil
         end
      end
   end,
})

